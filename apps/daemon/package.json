{
  "name": "@pcc/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "projectd": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --platform node --sourcemap --clean",
    "build:desktop": "tsup --config tsup.desktop.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@pcc/contracts": "workspace:*",
    "@pcc/database": "workspace:*",
    "@pcc/domain": "workspace:*",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
